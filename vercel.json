{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/games", "destination": "/index.html" },
    { "source": "/trivia", "destination": "/index.html" },
    { "source": "/play", "destination": "/index.html" },
    { "source": "/casino", "destination": "/casino/index.html" },
    { "source": "/casino/blackjack", "destination": "/casino/play.html?game=blackjack" },
    { "source": "/casino/poker", "destination": "/casino/play.html?game=poker" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
